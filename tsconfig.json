// lesson-loop/tsconfig.json —— 编译选项全部继承 @jayyuen66/dsh-plugin-shared/config/tsconfig.base.json，这里只留本包与基线不同的部分。
// 构建脚本（build-*.mjs）也进 include：oxlint 的类型引擎按"离被 lint 文件最近的
// tsconfig.json"挑程序，不进 include 的 .mjs 会落进默认程序（lib 低于脚本实际用的
// Node API），假报 TS2550 并级联 no-unsafe-*（src/tsconfig.json 注释里那条教训的同款）。
// typecheck 同时跑 tsconfig.build-scripts.json（noEmit 显式成档），两处 include 的并集
// 才是脚本的真实门。因此需要 allowJs/checkJs 把 .mjs 纳入检查（tsconfig.types.json 出
// 声明时是另一份配置，不受这里影响）。
{
  "extends": "@jayyuen66/dsh-plugin-shared/config/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "host.ts",
    "lib/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "build-client.mjs",
    "build-host.mjs",
    "build-types.mjs"
  ],
  "exclude": ["test/client-*.test.ts"]
}
